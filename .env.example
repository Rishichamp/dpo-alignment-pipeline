# ── SFT model (starting point for DPO) ─────────────────────────
# Use a base instruction-tuned model, OR point to the merged output
# of M6P1 (e.g. ../m6p1/merged_model) for a connected SFT->DPO pipeline
SFT_MODEL=meta-llama/Llama-3.2-3B
HF_TOKEN=hf_your_token_here

# ── LoRA config ───────────────────────────────────────────────
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# ── Quantisation ──────────────────────────────────────────────
USE_4BIT=true
USE_DOUBLE_QUANT=true
QUANT_TYPE=nf4

# ── DPO training ─────────────────────────────────────────────
OUTPUT_DIR=./output
DATA_PATH=./data/dpo_train.jsonl
EVAL_DATA_PATH=./data/dpo_eval.jsonl
BETA=0.1
PER_DEVICE_BATCH=2
GRAD_ACCUM=4
LEARNING_RATE=5e-5
NUM_EPOCHS=1
WARMUP_RATIO=0.05
MAX_LENGTH=1024
MAX_PROMPT_LENGTH=512
SAVE_STEPS=100
EVAL_STEPS=100
LOGGING_STEPS=10

# ── Inference / API ───────────────────────────────────────────
ADAPTER_PATH=./dpo_adapter
MERGED_PATH=./merged_dpo_model
APP_PORT=8002
APP_HOST=0.0.0.0

# Optional: for LLM-as-judge comparison in evaluate_dpo.py
OPENAI_API_KEY=sk-proj-your-key-here
